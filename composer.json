{
    "name": "kaizendeveloper/iniparser",
    "description": "A Zend_Config_Ini like parser for .ini files. Forked from austinhyde/iniparser because the old repo is not suitable for PHP 8.5.13",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Miguel Delli Carpini",
            "email": "noemail@noemail.com"
        },
        {
            "name": "Austin Hyde",
            "email": "austin109@gmail.com"
        },
        {
            "name": "Till Klampaeckel",
            "email": "till@php.net"
        }
    ],
    "autoload": {
        "psr-0": {
            "IniParser":"src/"
        }
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": ["configuration"]
}
